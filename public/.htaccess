# --- SPA (Vite/React) history fallback ---
Options -MultiViews
DirectoryIndex index.html
RewriteEngine On
# Si tu app estuviera en un subdirectorio, ajustá RewriteBase
# RewriteBase /
# No reescribir si el recurso físico existe
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
# Todo lo demás -> index.html (para rutas como /agrupaciones)
RewriteRule ^ index.html [L]

# --- Cache ---
<IfModule mod_headers.c>
  # index.html: NUNCA cachear, así los usuarios reciben la versión nueva al recargar
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  # version.json: tampoco cachear — es lo que usa el frontend para detectar
  # que hay una versión nueva mientras alguien ya tiene la app abierta.
  <FilesMatch "version\.json$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  # Assets con hash de Vite: inmutables (cambian de nombre en cada build)
  <FilesMatch "\.(js|css|woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|webp|ico|woff2?|ttf|eot)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
  # El HTML no hereda expires largo
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
  </FilesMatch>
</IfModule>
